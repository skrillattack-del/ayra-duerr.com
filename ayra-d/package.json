{
  "name": "startup-auth-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently -n FE,BE -c blue,green \"npm run dev\" \"npm run dev:backend\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "type-check": "dotenv -e .env.local -- tsc -p tsconfig.json --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "setup": "npm install && cd backend && npm install && cd .. && cp backend/.env.example backend/.env && cp .env.local.example .env.local",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:studio": "cd backend && npx prisma studio",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^4.6.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.559.0",
    "next": "^14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "socket.io-client": "^4.6.1",
    "tailwind-merge": "^2.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.0",
    "@playwright/test": "^1.40.0",
    "@storybook/addon-essentials": "^7.5.3",
    "@storybook/nextjs": "^7.5.3",
    "@testing-library/jest-dom": "^6.1.4",
    "@types/node": "^20.8.7",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.52.0",
    "eslint-config-next": "14.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.1",
    "storybook": "^9.0.16",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  }
}
