# ===========================================
# FitsiteGonga Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----------------- DATABASE -----------------
# PostgreSQL connection string
# Local (docker compose): postgresql://postgres:postgres@localhost:5432/fitsite
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitsite"

# ----------------- JWT AUTH -----------------
# Generate with: openssl rand -hex 32
JWT_SECRET="your-32-char-secret-here-generate-with-openssl"
JWT_REFRESH_SECRET="another-32-char-secret-for-refresh-tokens"

# ----------------- OBJECT STORAGE (MinIO / S3-compatible) -----------------
# Uploads (avatars, meal photos, etc.) are stored in an S3-compatible bucket.
# Use the Railway MinIO service's PRIVATE endpoint/host/port here (not the
# public one) — the backend talks to it server-to-server, never from the browser.
# The bucket is created automatically on first use if it doesn't already exist.
S3_ENDPOINT="http://minio.railway.internal:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-minio-root-user"
S3_SECRET_ACCESS_KEY="your-minio-root-password"
S3_BUCKET="gongafit-uploads"

# ----------------- SERVER -----------------
PORT=4000
NODE_ENV="development"

# Frontend URL for CORS (no trailing slash). Comma-separated for multiple origins.
FRONTEND_URL="http://localhost:3000"

# Optional explicit CORS origin. Defaults to FRONTEND_URL if not set.
# CORS_ORIGIN="http://localhost:3000"

# ----------------- MEMBERSHIP -----------------
# Membership tier is stored on the User model. FREE by default.
# Admins can upgrade users via PUT /api/users/:id/membership
# Users can also self-service switch via PATCH /api/users/me/plan
# (self-service switching is disabled automatically when Stripe is configured)

# ----------------- STRIPE BILLING (optional) -----------------
# When STRIPE_SECRET_KEY + STRIPE_PRICE_ID are set, the PAID tier is managed
# through Stripe Checkout/Billing Portal and webhooks keep membership in sync.
# Webhook endpoint: POST /api/billing/webhook (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed)
# Local dev: stripe listen --forward-to localhost:4000/api/billing/webhook
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."
# ALLOW_DEMO_TIER_SWITCH="true"   # keep the demo plan switcher even with Stripe on

# ----------------- ADMIN ACCESS -----------------
# Secret code a user can redeem (Settings page) to grant themselves ADMIN role.
ADMIN_SECRET_CODE="nhoj-reezy"
